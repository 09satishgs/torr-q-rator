# =================================================================
# TorrQrator Standalone Configuration (.env)
# =================================================================

# TorrQrator Web & API Server
PORT=3000
HOST=0.0.0.0

# Desktop qBittorrent WebUI Connection
# Ensure WebUI is enabled in qBittorrent: Tools -> Options -> Web UI
QBITTORRENT_BASE_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Desktop Prowlarr Connection
# Found in Prowlarr: Settings -> General -> API Key
PROWLARR_BASE_URL=http://localhost:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# FlareSolverr (Cloudflare Anti-Bot Bypasser)
FLARESOLVERR_BASE_URL=http://localhost:8191
FLARESOLVERR_ENABLED=true
FLARESOLVERR_TIMEOUT=60000

# Surfshark VPN Network Adapter Name (Used for qBittorrent binding)
# Windows: SurfsharkWireGuard or SurfsharkOpenVPN
VPN_INTERFACE_NAME=SurfsharkWireGuard
SURFSHARK_COUNTRY=Netherlands

# Default Download Directory (Leave blank to use user ~/Downloads or specify custom path)
# Windows Example: C:\Downloads or D:\Torrents
# Linux Example: /home/user/Downloads
DEFAULT_DOWNLOAD_DIR=

# Media Discovery API Keys (Optional for Wishlist & Discovery Tab)
OMDB_API_KEY=your_omdb_api_key
TMDB_API_KEY=your_tmdb_api_key
